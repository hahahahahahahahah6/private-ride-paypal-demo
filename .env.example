# Copy to .env and fill in yourself. Never commit .env.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
GEMINI_API_KEY=
# gemini-3.8-flash returned 503 (high demand) in live tests on 2026-11-01; 3.5-flash answered.
GEMINI_MODEL=gemini-3.5-flash
# Tried in order after GEMINI_MODEL on 429/500/503/bad JSON
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite
# Optional
PORT=3000
AI_MAX_REQUESTS=200
DRIVER_SANDBOX_EMAIL=
